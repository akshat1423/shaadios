# Copy to .env.local and fill in. Never commit .env.local.
# Everything is optional: with no keys the app still runs on safe defaults and a built-in parser.

# Claude: understands fuzzy requests ("make it feel like a royal Rajasthani evening"). Default model: claude-opus-5-5.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Flagsmith: feature flags + remote config (an environment key from app.flagsmith.com, or your self-hosted instance).
FLAGSMITH_ENVIRONMENT_KEY=
# FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1

# Sarvam AI: Indian-language speech-to-text and translation (from dashboard.sarvam.ai).
SARVAM_API_KEY=

# NudgeBee: the Event Webhook URL created in your NudgeBee workspace (Admin > Integrations > Webhooks).
NUDGEBEE_WEBHOOK_URL=
# NUDGEBEE_WEBHOOK_TOKEN=
